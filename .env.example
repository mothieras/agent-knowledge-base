# --- LLM provider (OpenAI-compatible; defaults to DeepSeek) ---
# DEEPSEEK_API_KEY=sk-...            # required — fill in .env (repo root), never commit it
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# JUDGE_MODEL=deepseek-chat

# --- Service (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000        # base URL the Gradio client uses to reach the API

# --- Langfuse Observability (optional) ---
# Set LANGFUSE_ENABLED=true and provide your API keys to enable tracing.
# Get your keys from https://cloud.langfuse.com or your self-hosted instance.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000
